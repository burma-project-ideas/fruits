@page "/"
<PageTitle>Fruit library | Fruits</PageTitle>
<header class="py-16 md:py-24 max-w-3xl mx-auto text-center"><p class="text-sm font-semibold text-neutral-300 mb-5">THE FRUIT LIBRARY · BURMA PROJECT IDEAS</p><h1 class="text-4xl md:text-5xl font-semibold tracking-tight leading-tight">Good things <br />grow naturally.</h1><p class="mt-6 text-lg text-neutral-400" lang="my">သစ်သီးအမျိုးမျိုးရဲ့ ပုံနဲ့ အချက်အလက်တွေကို လေ့လာကြမယ်။</p></header>
<section id="fruit-library" aria-labelledby="library-title">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-neutral-800 pb-8"><div><h2 id="library-title" class="text-2xl font-semibold">Explore the harvest</h2><p class="text-neutral-400 mt-2" role="status">@FilteredData.Count() fruits to discover</p></div><label class="text-sm font-medium">Search fruits<input type="search" class="block mt-2 rounded-full border border-neutral-700 bg-neutral-900 px-5 py-3 w-full md:w-80 focus:outline-white" placeholder="သစ်သီးအမည် ရှာပါ" @bind="SearchTerm" @bind:event="oninput" /></label></div>
@if(IsLoading){<p role="status" class="py-12">Loading the library…</p>}
else if(LoadError is not null){<p role="alert" class="py-12">@LoadError</p>}
else if(!FilteredData.Any()){<p class="py-12">No fruit found. Try another name.</p>}
else {
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 py-10">
@foreach(var item in FilteredData){
<article @key="item.Id" class="rounded-3xl border border-neutral-800 bg-neutral-900 overflow-hidden"><div class="aspect-square bg-neutral-800 p-8"><img class="w-full h-full object-contain rounded-2xl" src="@($"data/images/{item.Id}.jpg")" alt="@item.Name" loading="lazy" /></div><div class="p-6"><p class="text-xs tracking-widest text-neutral-300 mb-3">FRUIT / @item.Id.ToString("D2")</p><h3 class="text-2xl font-semibold leading-loose" lang="my">@item.Name</h3><details class="mt-4 group"><summary class="cursor-pointer text-sm font-medium text-neutral-200 py-2">Read about this fruit</summary><p class="mt-4 text-neutral-400 leading-loose" lang="my">@item.Description</p></details></div></article>
}
</div>
}
</section><p class="text-xs text-neutral-400 py-8">Reference content from the existing catalog. Health-related descriptions have not been medically reviewed.</p>
