@page "/"
<PageTitle>Home</PageTitle>

<RadzenDataGrid @ref="grid" AllowFiltering="true" AllowPaging="true" PageSize="3" AllowSorting="true" ExpandMode="DataGridExpandMode.Single"
                Data="@data" TItem="FruitModel">
    <Template Context="item">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Start" Gap="1rem" Class="rz-p-4">
            <RadzenImage Path="@(item?.Id.ToString() + ".jpg")" Style="width: 100px; height: 100px; border-radius: 50%;" />
            <RadzenStack Gap="0">
                <RadzenText TextStyle="TextStyle.Body1"><b>@(item.Name)</b></RadzenText>
            </RadzenStack>
        </RadzenStack>
        <p>
            @item?.Description
        </p>
    </Template>
    <Columns>
        <RadzenDataGridColumn TItem="FruitModel" Property="Id" Title="No." Width="120px" />
        <RadzenDataGridColumn TItem="FruitModel" Property="Name" Title="Name" Width="200px" />
        <RadzenDataGridColumn TItem="FruitModel" Property="Description" Title="Description" Width="200px" />
    </Columns>
</RadzenDataGrid>